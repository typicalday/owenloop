{
  "mcpServers": {
    "owenloop": {
      "command": "owenloop",
      "args": [
        "mcp"
      ],
      "env": {
        "OWENLOOP_PLUGIN_VERSION": "0.5.4"
      },
      "env_vars": [
        "HOME",
        "PATH",
        "XDG_CONFIG_HOME",
        "OWENLOOP_HUB",
        "OWENLOOP_NO_KEYCHAIN"
      ]
    }
  }
}
